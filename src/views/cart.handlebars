<section class="w-[92%] mx-auto py-8">
  <h1 class="text-xl tracking-widest uppercase text-[#1E1C1A] mb-8">Carrito de compras</h1>

  {{#if cart.products.length}}
    <div class="flex flex-col lg:flex-row gap-8">

      {{!-- Lista de productos --}}
      <div class="flex-1">

        {{!-- Header tabla — solo desktop --}}
        <div class="hidden md:grid grid-cols-[2fr_1fr_1fr_1fr_auto] gap-8 pb-3 border-b border-[#D4CFC8] text-xs uppercase tracking-widest text-[#B4AFA8] p-4">
          <span>Producto</span>
          <span class="text-center">Precio</span>
          <span class="text-center">Cantidad</span>
          <span class="text-center">Total</span>
          <span></span>
        </div>

        {{!-- Productos --}}
        <div class="flex flex-col divide-y divide-[#D4CFC8]">
          {{#each cart.products}}
            <div id="cart-item-{{this.product._id}}" class="py-4">

              {{!-- MOBILE: card compacta --}}
              <div class="flex gap-3 md:hidden bg-[#F5F2ED] p-4 rounded-sm">
                {{#if this.product.thumbnails.length}}
                  <img src="{{this.product.thumbnails.[0]}}" alt="{{this.product.title}}" class="w-20 h-20 object-cover flex-shrink-0">
                {{else}}
                  <div class="w-20 h-20 bg-[#DDD8CF] flex-shrink-0"></div>
                {{/if}}

                <div class="flex-1 min-w-0">
                  <div class="flex justify-between items-start">
                    <div>
                      <p class="text-xs text-[#B4AFA8] uppercase tracking-wider">{{this.product.category}}</p>
                      <h3 class="text-sm text-[#1E1C1A] truncate">{{this.product.title}}</h3>
                    </div>
                    <button onclick="removeProduct('{{../cart._id}}', '{{this.product._id}}')" class="text-[#D4CFC8] hover:text-[#B85C38] transition-colors ml-2 flex-shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                      </svg>
                    </button>
                  </div>

                  <div class="flex items-center justify-between mt-2">
                    <div class="flex items-center gap-2">
                      <button onclick="updateQuantity('{{../cart._id}}', '{{this.product._id}}', {{this.quantity}}, -1)" class="w-6 h-6 border border-[#D4CFC8] text-[#1E1C1A] hover:bg-[#1E1C1A] hover:text-white transition-colors text-xs">−</button>
                      <span id="qty-{{this.product._id}}" class="text-sm w-5 text-center tabular-nums">{{this.quantity}}</span>
                      <button onclick="updateQuantity('{{../cart._id}}', '{{this.product._id}}', {{this.quantity}}, 1)" class="w-6 h-6 border border-[#D4CFC8] text-[#1E1C1A] hover:bg-[#1E1C1A] hover:text-white transition-colors text-xs">+</button>
                    </div>
                    <p class="text-sm font-medium text-[#1E1C1A] tabular-nums" id="subtotal-{{this.product._id}}">${{multiply this.product.price this.quantity}}</p>
                  </div>
                </div>
              </div>

              {{!-- DESKTOP: fila de tabla --}}
              <div class="hidden md:grid grid-cols-[2fr_1fr_1fr_1fr_auto] gap-4 items-center bg-[#F5F2ED] p-4">

                {{!-- Producto --}}
                <div class="flex gap-4 items-center">
                  {{#if this.product.thumbnails.length}}
                    <img src="{{this.product.thumbnails.[0]}}" alt="{{this.product.title}}" class="w-16 h-16 object-cover flex-shrink-0">
                  {{else}}
                    <div class="w-16 h-16 bg-[#DDD8CF] flex-shrink-0"></div>
                  {{/if}}
                  <div>
                    <p class="text-xs text-[#B4AFA8] uppercase tracking-wider">{{this.product.category}}</p>
                    <h3 class="text-sm text-[#1E1C1A]">{{this.product.title}}</h3>
                  </div>
                </div>

                {{!-- Precio --}}
                <p class="text-sm text-[#1E1C1A] text-center tabular-nums">${{this.product.price}}</p>

                {{!-- Cantidad --}}
                <div class="flex items-center justify-center gap-2">
                  <button onclick="updateQuantity('{{../cart._id}}', '{{this.product._id}}', {{this.quantity}}, -1)" class="w-7 h-7 border border-[#D4CFC8] text-[#1E1C1A] hover:bg-[#1E1C1A] hover:text-white transition-colors text-sm">−</button>
                  <span id="qty-{{this.product._id}}" class="text-sm w-6 text-center tabular-nums">{{this.quantity}}</span>
                  <button onclick="updateQuantity('{{../cart._id}}', '{{this.product._id}}', {{this.quantity}}, 1)" class="w-7 h-7 border border-[#D4CFC8] text-[#1E1C1A] hover:bg-[#1E1C1A] hover:text-white transition-colors text-sm">+</button>
                </div>

                {{!-- Total --}}
                <p class="text-sm text-[#1E1C1A] text-center tabular-nums" id="subtotal-{{this.product._id}}">${{multiply this.product.price this.quantity}}</p>

                {{!-- Eliminar --}}
                <button onclick="removeProduct('{{../cart._id}}', '{{this.product._id}}')" class="text-[#D4CFC8] hover:text-[#B85C38] transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                  </svg>
                </button>

              </div>
            </div>
          {{/each}}
        </div>
      </div>

      {{!-- Resumen --}}
      <div class="lg:w-[380px] h-fit p-6 border border-[#D4CFC8] bg-[#F5F2ED]">
        <h2 class="text-sm uppercase tracking-widest text-[#1E1C1A] mb-6">Resumen de compra</h2>
        <hr class="border-[#D4CFC8] mb-6" />

        <div class="flex justify-between text-sm text-[#6B6560] mb-3">
          <span>Subtotal</span>
          <span id="cart-total">${{total}}</span>
        </div>

        <div class="flex justify-between text-sm text-[#6B6560] mb-6">
          <span>Envío</span>
          <span>A calcular</span>
        </div>

        <div class="border-t border-[#D4CFC8] pt-4 flex justify-between font-medium text-[#1E1C1A] mb-6">
          <span>Total</span>
          <span id="cart-total-final">${{total}}</span>
        </div>

        <button class="w-full py-3 bg-[#1E1C1A] text-[#F5F2ED] text-xs tracking-widest uppercase hover:bg-[#6B6560] transition-colors">
          Finalizar compra
        </button>

        <a href="/products" class="block text-center text-xs text-[#B4AFA8] hover:text-[#1E1C1A] transition-colors mt-4 tracking-wider">
          ← Seguir comprando
        </a>
      </div>

    </div>

  {{else}}
    <div class="flex flex-col items-center justify-center py-24 gap-4">
      <p class="text-[#B4AFA8] tracking-wide">Tu carrito está vacío</p>
      <a href="/products" class="text-xs tracking-widest uppercase border border-[#1E1C1A] px-6 py-3 hover:bg-[#1E1C1A] hover:text-[#F5F2ED] transition-colors">
        Ver productos
      </a>
    </div>
  {{/if}}

</section>

<script src="/js/cart.js"></script>