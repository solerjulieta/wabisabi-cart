<style>
  #main-image {
    transition: opacity 0.3s ease;
  }
</style>
<section class="w-[92%] mx-auto py-8">
  <a href="/products" class="text-xs tracking-widest text-[#B4AFA8] hover:text-[#B85C38] transition-colors uppercase">
    ← volver a productos
  </a>

  <div class="flex flex-col md:flex-row gap-12 mt-8">

    {{!-- Imágenes --}}
    <div class="md:max-w-[510px]">
      {{#if product.thumbnails.length}}

        {{!-- Imagen principal --}}
        <div class="relative overflow-hidden bg-[#DDD8CF]" id="image-container">
          <img
            src="{{product.thumbnails.[0]}}"
            alt="{{product.title}}"
            class="w-full aspect-square object-cover"
            id="main-image"
          >
        </div>

        {{!-- Mobile: puntos indicadores --}}
        {{#if (gt product.thumbnails.length 1)}}
          <div class="flex md:hidden justify-center gap-2 mt-3">
            {{#each product.thumbnails}}
              <button
                onclick="setImageByIndex('{{@index}}', this)"
                class="w-1.5 h-1.5 rounded-full bg-[#D4CFC8] transition-colors dot-indicator {{#if @first}}bg-[#1E1C1A]{{/if}}"
                aria-label="imagen {{@index}}"
              ></button>
            {{/each}}
          </div>
        {{/if}}

        {{!-- Desktop: miniaturas laterales --}}
        {{#if (gt product.thumbnails.length 1)}}
          <div class="hidden md:flex gap-2 mt-3">
            {{#each product.thumbnails}}
              <button
                onclick="setImage('{{this}}', this)"
                class="flex-shrink-0 w-20 h-20 overflow-hidden border border-[#D4CFC8] hover:border-[#1E1C1A] transition-colors thumbnail-btn {{#if @first}}border-[#1E1C1A]{{/if}}"
              >
                <img
                  src="{{this}}"
                  alt="vista {{@index}}"
                  class="w-full h-full object-cover"
                >
              </button>
            {{/each}}
          </div>
        {{/if}}

      {{else}}
        <div class="w-full aspect-square bg-[#DDD8CF] flex items-center justify-center text-[#B4AFA8] text-sm tracking-wider">
          sin imagen
        </div>
      {{/if}}
    </div>

    {{!-- Info --}}
    <div class="md:w-1/2 flex flex-col justify-center">

      <p class="text-xs text-[#B4AFA8] uppercase tracking-widest mb-3">{{product.category}}</p>

      <h1 class="text-3xl text-[#1E1C1A] mb-4 font-normal" style="font-family:'Shippori Mincho',serif;font-weight:400">
        {{product.title}}
      </h1>

      <p class="text-2xl text-[#1E1C1A] mb-6" style="font-weight:300">${{product.price}}</p>

      <p class="text-[#6B6560] text-sm leading-relaxed mb-6" style="font-weight:300">{{product.description}}</p>

      <div class="border-t border-[#D4CFC8] pt-6 mb-6">
        {{#if product.stock}}
          <p class="text-xs tracking-widest text-[#7A8C6E] uppercase">
            stock disponible · {{product.stock}} unidades
          </p>
        {{else}}
          <p class="text-xs tracking-widest text-[#B85C38] uppercase">sin stock</p>
        {{/if}}
      </div>

      <button
        id="add-to-cart"
        data-pid="{{product._id}}"
        class="w-full md:max-w-[400px] px-8 py-3 border border-[#1E1C1A] text-[#1E1C1A] text-xs tracking-widest uppercase hover:bg-[#1E1C1A] hover:text-[#F5F2ED] transition-colors duration-300 disabled:opacity-30 disabled:cursor-not-allowed"
        {{#unless product.stock}}disabled{{/unless}}
      >
        agregar al carrito
      </button>

      <p id="cart-message" class="text-xs tracking-wider mt-4 hidden text-[#7A8C6E]"></p>

    </div>
  </div>
</section>

<script>
  const thumbnails = {{{json product.thumbnails}}};
  let currentIndex = 0;

  function updateDots(index) {
    document.querySelectorAll('.dot-indicator').forEach((dot, i) => {
      dot.classList.toggle('bg-[#1E1C1A]', i === index);
      dot.classList.toggle('bg-[#D4CFC8]', i !== index);
    });
  }

  function updateThumbnails(index) {
    document.querySelectorAll('.thumbnail-btn').forEach((btn, i) => {
      btn.classList.toggle('border-[#1E1C1A]', i === index);
      btn.classList.toggle('border-[#D4CFC8]', i !== index);
    });
  }

  function setImageByIndex(index) {
    const img = document.getElementById('main-image');

    img.style.opacity = '0';

    setTimeout(() => {
      currentIndex = index;
      img.src = thumbnails[index];
      img.style.opacity = '1';
      updateDots(index);
      updateThumbnails(index);
    }, 300);
  }

  // Swipe táctil
  let touchStartX = 0;
  let touchEndX = 0;

  const container = document.getElementById('image-container');

  container.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  container.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipe();
  }, { passive: true });

  function handleSwipe() {
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) < 50) return; // ignorar swipes muy cortos

    if (diff > 0) {
      // swipe izquierda → siguiente
      currentIndex = (currentIndex + 1) % thumbnails.length;
    } else {
      // swipe derecha → anterior
      currentIndex = (currentIndex - 1 + thumbnails.length) % thumbnails.length;
    }

    setImageByIndex(currentIndex);
  }
</script>

<script src="/js/product-detail.js"></script>