<section class="w-[92%] mx-auto py-8">
    <h1>Nuestros productos</h1>
    {{> products-sort}}
    <div class="md:flex mt-8">
        {{> product-filters}}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {{#each products}}
                {{> product-card}}
            {{/each}}
        </div>
    </div>
</section>