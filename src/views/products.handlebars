{{> announcement}}
<section class="w-[92%] mx-auto py-8">
    <h1 class="text-[#1E1C1A] tracking-widest mb-8">Nuestros productos</h1>
    {{> products-sort}}
    <div class="md:flex mt-8 gap-10">
        {{> product-filters}}
        <div id="products-grid" class="grid grid-cols-2 md:grid-cols-5 gap-4">
            {{#each products}}
                {{> product-card}}
            {{/each}}
        </div>
    </div>
    <div id="pagination" class="flex items-center justify-center gap-4 mt-10">
        {{#if hasPrevPage}}
            <a href="{{prevLink}}" class="px-5 py-2 text-xs tracking-widest border border-[#D4CFC8] text-[#6B6560] hover:border-[#1E1C1A] hover:text-[#1E1C1A] transition-colors">← Anterior</a>
        {{/if}}
            <span class="text-xs text-[#B4AFA8] tracking-wider">{{page}} / {{totalPages}}</span>
        {{#if hasNextPage}}
            <a href="{{nextLink}}" class="px-5 py-2 text-xs tracking-widest border border-[#D4CFC8] text-[#6B6560] hover:border-[#1E1C1A] hover:text-[#1E1C1A] transition-colors">Siguiente →</a>
        {{/if}}
    </div>
</section>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/products.js"></script>