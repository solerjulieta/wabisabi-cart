<section class="w-[92%] mx-auto py-8">
    <h1>Nuestros productos</h1>
    {{> products-sort}}
    <div class="md:flex mt-8">
        {{> product-filters}}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {{#each products}}
                {{> product-card}}
            {{/each}}
        </div>
    </div>
    <div class="flex items-center justify-center gap-4 mt-8">
        {{#if hasPrevPage}}
            <a href="{{prevLink}}" class="px-4 py-2 text-sm rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colorsc">← Anterior</a>
        {{/if}}
            <span class="text-sm text-gray-500">{{page}} / {{totalPages}}</span>
        {{#if hasNextPage}}
            <a href="{{nextLink}}" class="px-4 py-2 text-sm rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors">Siguiente →</a>
        {{/if}}
    </div>
</section>